# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for Cloud Run / Raspberry Pi
APP_URL="MY_APP_URL"

# GROWW API CREDENTIALS (Required for Live Trading mode on NSE)
# Get your API Key, Secret and TOTP secret key from the Groww Developer Console
GROWW_API_TOKEN="your_groww_api_token_here"
GROWW_API_SECRET="your_groww_api_secret_here"
GROWW_TOTP_KEY="your_groww_totp_key_here"

# RASPBERRY PI DAEMON & FAULT TOLERANCE SETTINGS
NODE_ENV="production"
PORT=3000
DATABASE_MODE="WAL" # SQLite Write-Ahead Logging for power-loss resilience
AUTO_RESTART_ON_CRASH=true

